{
  "name": "3d-animation",
  "version": "1.0.0",
  "description": "3D animated videos with Three.js and Remotion",
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render src/index.tsx OutputVideo --gl=angle",
    "build:all": "remotion render src/index.tsx OutputVideo --gl=angle && remotion render src/index.tsx Captions --gl=angle",
    "preview": "remotion preview src/index.tsx",
    "studio": "remotion studio"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/player": "^4.0.0",
    "remotion": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "@types/three": "^0.169.0"
  },
  "devDependencies": {
    "@remotion/eslint-config": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "typescript": "^5.6.3"
  }
}